<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>NaverMapClicker</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21</javafx.version>
        <!-- jpackage로 exe 설치파일을 만들 때 필요한 WiX Toolset v3 bin 경로.
             다른 PC에서 빌드할 경우 -Dwix.bin.dir=... 로 재정의한다. -->
        <wix.bin.dir>C:\Program Files (x86)\WiX Toolset v3.14\bin</wix.bin.dir>
    </properties>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- 전역 단축키 -->
        <dependency>
            <groupId>com.github.kwhat</groupId>
            <artifactId>jnativehook</artifactId>
            <version>2.2.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JavaFX 실행 플러그인 -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>dev.naverclicker.Main</mainClass>
                </configuration>
            </plugin>

            <!-- 모든 의존성을 target/lib 폴더에 복사 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 메인 JAR (의존성 제외) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>dev.naverclicker.Main</mainClass>
                        </manifest>
                    </archive>
                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                    <finalName>NaverMapClicker</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 사용법: mvn clean package -Pinstaller
             자바/JavaFX가 설치되지 않은 PC에서도 실행 가능한 EXE 설치파일을
             target/dist 에 생성한다. Windows에서 exe/msi 생성에는 WiX Toolset v3가 필요하다
             (https://wixtoolset.org/ 에서 v3.x 설치). -->
        <profile>
            <id>installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-exe</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <environmentVariables>
                                        <PATH>${wix.bin.dir};${env.PATH}</PATH>
                                    </environmentVariables>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>exe</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/lib</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument>
                                        <argument>NaverMapClicker</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0</argument>
                                        <argument>--vendor</argument>
                                        <argument>NaverMapClicker</argument>
                                        <argument>--main-jar</argument>
                                        <argument>NaverMapClicker.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>dev.naverclicker.Main</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-dir-chooser</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
